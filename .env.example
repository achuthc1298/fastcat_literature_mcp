# Copy this file to .env. Add your own keys there; never commit .env.
# Search credentials (recommended; limited anonymous access may be available)
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Only needed for the corresponding publisher download tool
ELSEVIER_API_KEY=
SPRINGER_NATURE_API_KEY=
# Optional: only if your institution/Elsevier provides one
ELSEVIER_INST_TOKEN=

# Local storage; relative paths are resolved from the project directory
DATA_DIR=./data
HF_HOME=./models/huggingface

# Default evidence retrieval settings; beginners can leave these unchanged
RAG_CHUNK_TOKENS=384
RAG_CHUNK_OVERLAP=64

# Optional legacy Qwen summarization (Apple Silicon macOS only)
LOCAL_MODEL=mlx-community/Qwen3.5-2B-4bit
CHUNK_TOKENS=1800
CHUNK_OVERLAP=150
EXTRACTION_MAX_TOKENS=900
